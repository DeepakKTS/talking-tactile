{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "talking-tactile/regions.schema.json",
  "title": "Talking Tactile regions file",
  "description": "The contract between Author and Explore. Explore must run from this file alone for labels, earcons and guidance.",
  "type": "object",
  "required": ["schema_version", "figure_id", "title", "figure_type", "page", "summary", "textures", "regions"],
  "properties": {
    "schema_version": { "const": 3 },
    "figure_id": { "type": "string", "description": "sha256 of the normalized source image" },
    "title": { "type": "string" },
    "figure_type": { "enum": ["labeled_diagram", "bar_chart", "line_graph", "map", "flow_diagram", "other"] },
    "grade_band": { "enum": ["k5", "6_8", "9_12", "college"] },
    "page": {
      "type": "object",
      "required": ["size", "width_mm", "height_mm"],
      "properties": {
        "size": { "enum": ["letter", "a4"] },
        "width_mm": { "type": "number" },
        "height_mm": { "type": "number" }
      }
    },
    "summary": { "type": "string", "description": "Spoken on first open. Two sentences at most." },
    "textures": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "meaning", "earcon_hz"],
        "properties": {
          "id": { "enum": ["dots", "lines", "cross", "grid", "solid"] },
          "meaning": { "type": "string" },
          "earcon_hz": { "type": "number" }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "polygon_mm", "source", "verified_by_teacher", "touchable"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string", "description": "Spoken on dwell. The label only." },
          "abbrev": { "type": "string", "description": "Braille key abbreviation when the full label does not fit" },
          "description": { "type": "string", "description": "Spoken on 'more'. One or two sentences, from the figure or its caption." },
          "polygon_mm": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "minItems": 3, "maxItems": 200 },
          "centroid_mm": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "texture": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "neighbors": {
            "type": "array",
            "description": "Computed in code. Direction is from this region to the neighbor.",
            "items": {
              "type": "object",
              "required": ["id", "direction"],
              "properties": {
                "id": { "type": "string" },
                "direction": { "enum": ["up", "down", "left", "right", "up_left", "up_right", "down_left", "down_right", "inside", "around"] }
              }
            }
          },
          "source": { "enum": ["sam", "teacher"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "verified_by_teacher": { "type": "boolean" },
          "touchable": { "type": "boolean", "description": "False for a teacher suggestion: not raised on the sheet, and Explore never speaks it or guides to it." },
          "flags": {
            "type": "array",
            "description": "Why the region needs a look. spill: SAM's mask held another part's prompt point; it is a suggestion and never touchable. thin and under_point_symbol leave the region touchable.",
            "items": {
              "type": "object",
              "required": ["reason", "detail"],
              "properties": {
                "reason": { "enum": ["spill", "thin", "under_point_symbol"] },
                "detail": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "description": "The whole object the figure shows, and its outline: the silhouette. Explore says the label once each time a finger rests inside it on no part.",
      "required": ["label", "polygon_mm"],
      "properties": {
        "label": { "type": "string" },
        "polygon_mm": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "minItems": 3, "maxItems": 200 }
      }
    },
    "lines": {
      "type": "array",
      "description": "Parts that are lines, such as a sulcus or a border: never raised as areas and never touchable. Explore says a line's label when the finger crosses from one region it separates into the other.",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "separates": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2, "description": "The touchable regions on either side, each by its part's main region id" },
          "between": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2, "description": "The labels of the two parts it separates, for the teacher" },
          "parent": { "type": ["string", "null"], "description": "The region the line lies in, when it separates no two touchable regions" }
        }
      }
    },
    "merge_proposals": {
      "type": "array",
      "description": "Touchable regions drawn as one unbroken shape, which the teacher may merge under the suggested name.",
      "items": {
        "type": "object",
        "required": ["name", "region_ids", "why"],
        "properties": {
          "name": { "type": "string" },
          "region_ids": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "why": { "type": "string" }
        }
      }
    },
    "needs_teacher": {
      "type": "array",
      "description": "Listed parts with no shape to touch: no prompt point survived, SAM gave no mask, or S3 dropped the part.",
      "items": {
        "type": "object",
        "required": ["id", "label", "reason", "detail"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "reason": { "enum": ["no_points", "no_mask", "dropped"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
